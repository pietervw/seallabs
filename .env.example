# =============================================================================
# Seal Labs (seallabs.io) — environment variables
# Copy to `.env.local` for local development. Never commit real secrets.
# Canonical production origin is apex https://seallabs.io (no www).
# NEXT_PUBLIC_* values are inlined at `next build` — set them in Coolify/Docker
# build-time env (or --build-arg), not only as runtime secrets.
# =============================================================================

# Public site origin used for metadataBase, canonicals, sitemap, robots, and llms.txt.
NEXT_PUBLIC_SITE_URL=https://seallabs.io

# Brand / identity (shown in metadata, JSON-LD, and UI)
NEXT_PUBLIC_SITE_NAME=Seal Labs
NEXT_PUBLIC_SITE_LEGAL_NAME=Seal Labs
NEXT_PUBLIC_SUPPORT_EMAIL=hello@seallabs.io

# -----------------------------------------------------------------------------
# Contact form (/api/contact) — required in production for form delivery
# Prefer SendGrid when SENDGRID_API_KEY is set; otherwise SMTP is used.
# -----------------------------------------------------------------------------
CONTACT_TO_EMAIL=hello@seallabs.io
CONTACT_FROM_EMAIL=Seal Labs <noreply@seallabs.io>

# SendGrid (recommended)
SENDGRID_API_KEY=

# SMTP fallback (optional if SendGrid is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (optional bot protection on contact form)
# Both keys required — site key alone shows the widget but does not protect the API;
# secret alone (without a build-time site key) is ignored so the form still works.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Pushover ops alerts (optional)
# Same env names across Seal Labs apps. Both required to enable.
# Notifies on successful contact form submissions (fire-and-forget).
# -----------------------------------------------------------------------------
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=

# -----------------------------------------------------------------------------
# Social / sameAs for Organization schema (optional absolute URLs)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_EMAIL=mailto:hello@seallabs.io

# -----------------------------------------------------------------------------
# Runtime (Docker / Coolify)
# NODE_ENV is set by the image. Bind all interfaces inside the container:
# HOSTNAME=0.0.0.0
# PORT=3000
# -----------------------------------------------------------------------------
